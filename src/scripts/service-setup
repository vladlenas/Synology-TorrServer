### Generic variables and functions
### -------------------------------

if [ -z "${SYNOPKG_PKGNAME}" ] || [ -z "${SYNOPKG_DSM_VERSION_MAJOR}" ]; then
  echo "Error: Environment variables are not set." 1>&2
  echo "Please run me using synopkg instead. Example: \"synopkg start [packagename]\"" 1>&2
  exit 1
fi

USER="TorrServer"
EFF_USER="TorrServer"

# start-stop-status script log
LOG_FILE="/var/packages/${SYNOPKG_PKGNAME}/var/${SYNOPKG_PKGNAME}.log"

# Service command has to deliver its pid into PID_FILE
PID_FILE="/var/packages/${SYNOPKG_PKGNAME}/var/${SYNOPKG_PKGNAME}.pid"

# Package config files
CONFIG_DIR="/var/packages/${SYNOPKG_PKGNAME}/var"

# TorrServer log
TORRSERVER_LOG="/var/packages/${SYNOPKG_PKGNAME}/var/TorrServer.log"

# Sudoers rule for Helper restart button
SUDOERS_FILE="/etc/sudoers.d/TorrServer"

# Root restart helper
RESTART_SCRIPT="/var/packages/${SYNOPKG_PKGNAME}/scripts/restart-package"


### Package specific variables and functions
### ----------------------------------------

# TorrServer Web port
TORRSERVER_PORT="8090"

if [ -r "${CONFIG_DIR}/torrserver.port" ]; then
    SAVED_PORT="$(cat "${CONFIG_DIR}/torrserver.port" 2>/dev/null)"

    case "${SAVED_PORT}" in
        ''|*[!0-9]*)
            ;;
        *)
            if [ "${SAVED_PORT}" -ge 1 ] 2>/dev/null &&
               [ "${SAVED_PORT}" -le 65535 ] 2>/dev/null; then
                TORRSERVER_PORT="${SAVED_PORT}"
            fi
            ;;
    esac
fi

# Update DSM firewall port configuration for the current TorrServer port.
update_firewall_port ()
{
    local SC_FILE="${SYNOPKG_PKGDEST}/ui/TorrServer.sc"

    cat > "${SC_FILE}" <<EOF
[torrserver]
title="TorrServer MatriX"
desc="TorrServer MatriX"
port_forward="yes"
dst.ports="${TORRSERVER_PORT}/tcp"
EOF

    /usr/syno/sbin/synopkghelper update "${SYNOPKG_PKGNAME}" port-config >/dev/null 2>&1
}

update_firewall_port

# TorrServer HTTP authentication
AUTH_ENABLED="0"

if [ -r "${CONFIG_DIR}/torrserver.auth" ]; then
    if [ "$(cat "${CONFIG_DIR}/torrserver.auth" 2>/dev/null)" = "1" ] &&
       [ -r "${CONFIG_DIR}/accs.db" ]; then
        AUTH_ENABLED="1"
    fi
fi

if [ "${AUTH_ENABLED}" = "1" ]; then
    SERVICE_COMMAND="/bin/python3 ${SYNOPKG_PKGDEST}/helper/helper.py
${SYNOPKG_PKGDEST}/bin/TorrServer -d ${SYNOPKG_PKGVAR} -p ${TORRSERVER_PORT} -a ${TORRSERVER_SSL_ARGS} -l ${TORRSERVER_LOG}"
else
    SERVICE_COMMAND="/bin/python3 ${SYNOPKG_PKGDEST}/helper/helper.py
${SYNOPKG_PKGDEST}/bin/TorrServer -d ${SYNOPKG_PKGVAR} -p ${TORRSERVER_PORT} ${TORRSERVER_SSL_ARGS} -l ${TORRSERVER_LOG}"
fi

HTTPS_ENABLED="0"
if [ -r "${CONFIG_DIR}/torrserver.https" ] &&
   [ "$(cat "${CONFIG_DIR}/torrserver.https" 2>/dev/null)" = "1" ]; then
    HTTPS_ENABLED="1"
fi

HTTPS_PORT="8091"
if [ -r "${CONFIG_DIR}/torrserver.https.port" ]; then
    SAVED_HTTPS_PORT="$(cat "${CONFIG_DIR}/torrserver.https.port" 2>/dev/null)"
    case "${SAVED_HTTPS_PORT}" in
        ''|*[!0-9]*) ;;
        *)
            if [ "${SAVED_HTTPS_PORT}" -ge 1 ] 2>/dev/null &&
               [ "${SAVED_HTTPS_PORT}" -le 65535 ] 2>/dev/null; then
                HTTPS_PORT="${SAVED_HTTPS_PORT}"
            fi
            ;;
    esac
fi

TORRSERVER_SSL_ARGS=""
if [ "${HTTPS_ENABLED}" = "1" ]; then
    TORRSERVER_SSL_ARGS="--ssl --sslport ${HTTPS_PORT}"
fi

SVC_BACKGROUND=y
SVC_WRITE_PID=y


service_postinst ()
{
    # Create restricted sudoers rule for Helper restart.
    # Only the dedicated root restart script is allowed.
    mkdir -p /etc/sudoers.d

    cat > "${SUDOERS_FILE}" <<EOF
TorrServer ALL=(root) NOPASSWD: ${RESTART_SCRIPT}
EOF

    chmod 0440 "${SUDOERS_FILE}"

    if [ "${SYNOPKG_PKG_STATUS}" = "INSTALL" ]; then
        if [ "${wizard_enable_aut}" = "true" ]; then
            echo "{" >> ${SYNOPKG_PKGVAR}/accs.db | install_log
            echo '"@user@":"@password@"' >> ${SYNOPKG_PKGVAR}/accs.db | install_log
            echo "}" >> ${SYNOPKG_PKGVAR}/accs.db | install_log

            sed -i -e "s|@user@|${wizard_username:=admin}|g" ${SYNOPKG_PKGVAR}/accs.db | install_log
            sed -i -e "s|@password@|${wizard_password:=admin}|g" ${SYNOPKG_PKGVAR}/accs.db | install_log
        fi
    fi
}


service_preupgrade ()
{
    if [ -d ${SYNOPKG_PKGDEST}/config/ -a "$(ls -A ${SYNOPKG_PKGDEST}/config/ 2>/dev/null)" ]; then
        if [ -r "${SYNOPKG_PKGDEST}/config/${SYNOPKG_PKGNAME}.sc" ]; then
            $RM ${SYNOPKG_PKGDEST}/config/${SYNOPKG_PKGNAME}.sc | install_log
        fi

        echo "Backup target/config folder" | install_log
        echo "$RSYNC ${SYNOPKG_PKGDEST}/config/ ${TMP_DIR}" | install_log
        $RSYNC ${SYNOPKG_PKGDEST}/config/ ${TMP_DIR} 2>&1 | install_log
    fi
}


service_postuninst ()
{
    # Remove the restricted sudoers rule when the package is uninstalled.
    if [ -f "${SUDOERS_FILE}" ]; then
        rm -f "${SUDOERS_FILE}"
    fi
}
