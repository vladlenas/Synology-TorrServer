#!/bin/sh

CERT_ROOT="/usr/syno/etc/certificate"
CONFIG_DIR="/var/packages/TorrServer/var"
TARGET_CERT="${CONFIG_DIR}/server.pem"
TARGET_KEY="${CONFIG_DIR}/server.key"
LOG_FILE="${CONFIG_DIR}/Helper.log"

log_message()
{
    if [ -f "$LOG_FILE" ] && [ "$(wc -c < "$LOG_FILE")" -ge 2097152 ]; then
        mv -f "$LOG_FILE" "${LOG_FILE}.1" 2>/dev/null
    fi

    printf '%s certificate-helper: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$LOG_FILE" 2>/dev/null
}

list_certificates()
{
    printf '['
    first=1

    for info in $(find "$CERT_ROOT" -type f -name info); do
        data=$(cat "$info" 2>/dev/null) || continue

        if [ "$first" -eq 0 ]; then
            printf ','
        fi
        first=0

        printf '%s' "$data"
    done

    printf ']'
    printf '\n'
}

sync_certificate()
{
    MODE="$(cat "${CONFIG_DIR}/torrserver.ssl.mode" 2>/dev/null)"

    case "$MODE" in
        self|"")
            exit 0
            ;;

        dsm|manual)
            ;;
        *)
            echo "Invalid certificate mode: ${MODE}" >&2
            log_message "ERROR: invalid certificate mode: ${MODE}"
            exit 1
            ;;
    esac

    CERT="$(cat "${CONFIG_DIR}/torrserver.ssl.cert" 2>/dev/null)"
    KEY="$(cat "${CONFIG_DIR}/torrserver.ssl.key" 2>/dev/null)"

    if [ -z "$CERT" ] || [ -z "$KEY" ]; then
        log_message "ERROR: certificate or key path is empty"
        echo "Certificate or key path is empty" >&2
        exit 1
    fi

    if [ "$MODE" = "dsm" ]; then
        case "$CERT" in
            /usr/syno/etc/certificate/*) ;;
            *)
                log_message "ERROR: invalid DSM certificate path"
                echo "Invalid DSM certificate path" >&2
                exit 1
                ;;
        esac

        case "$KEY" in
            /usr/syno/etc/certificate/*) ;;
            *)
                log_message "ERROR: invalid DSM key path"
                echo "Invalid DSM key path" >&2
                exit 1
                ;;
        esac
    fi

    if [ "$MODE" = "manual" ]; then
        case "$CERT" in
            /volume[0-9]/*) ;;
            *)
                log_message "ERROR: manual certificate path outside /volumeX/"
                echo "Manual certificate must be inside /volumeX/" >&2
                exit 1
                ;;
        esac

        case "$KEY" in
            /volume[0-9]/*) ;;
            *)
                log_message "ERROR: manual key path outside /volumeX/"
                echo "Manual key must be inside /volumeX/" >&2
                exit 1
                ;;
        esac
    fi

    if [ ! -f "$CERT" ]; then
        log_message "ERROR: certificate file not found: ${CERT}"
        echo "Certificate file not found: ${CERT}" >&2
        exit 1
    fi

    if [ ! -f "$KEY" ]; then
        log_message "ERROR: key file not found: ${KEY}"
        echo "Key file not found: ${KEY}" >&2
        exit 1
    fi

    NEED_CERT=1
    NEED_KEY=1

    if [ -f "$TARGET_CERT" ] && cmp -s "$CERT" "$TARGET_CERT"; then
        NEED_CERT=0
    fi

    if [ -f "$TARGET_KEY" ] && cmp -s "$KEY" "$TARGET_KEY"; then
        NEED_KEY=0
    fi

    if [ "$NEED_CERT" -eq 0 ] && [ "$NEED_KEY" -eq 0 ]; then
        exit 0
    fi

    TMP_CERT="${TARGET_CERT}.tmp"
    TMP_KEY="${TARGET_KEY}.tmp"

    rm -f "$TMP_CERT" "$TMP_KEY"

    if [ "$NEED_CERT" -eq 1 ]; then
        cp "$CERT" "$TMP_CERT" || exit 1
        chown TorrServer:TorrServer "$TMP_CERT" || exit 1
        chmod 0644 "$TMP_CERT"
    fi

    if [ "$NEED_KEY" -eq 1 ]; then
        cp "$KEY" "$TMP_KEY" || exit 1
        chown TorrServer:TorrServer "$TMP_KEY" || exit 1
        chmod 0600 "$TMP_KEY"
    fi

    if [ "$NEED_CERT" -eq 1 ]; then
        mv -f "$TMP_CERT" "$TARGET_CERT" || exit 1
    fi

    if [ "$NEED_KEY" -eq 1 ]; then
        mv -f "$TMP_KEY" "$TARGET_KEY" || exit 1
    fi

    log_message "TLS certificate synchronized successfully (mode: ${MODE})"

    exit 0
}

case "$1" in
    sync)
        sync_certificate
        ;;
    *)
        list_certificates
        ;;
esac
